{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodecode Native Mod beta 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sdkVersion",
    "cortexCompatibility",
    "renderer",
    "adapter"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "sdkVersion": {
      "const": "2.0.0-beta.1"
    },
    "cortexCompatibility": {
      "const": "v5-native-screen-1"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "abiVersion",
        "language"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "abiVersion": {
          "const": 1
        },
        "language": {
          "enum": [
            "c",
            "cpp"
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "entry"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "json"
          ]
        },
        "entry": {
          "type": "string"
        }
      }
    }
  }
}
