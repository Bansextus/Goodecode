{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodebot.net/schemas/goodecode-native-mod-package-v2.json",
  "title": "Goodecode native mod package metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "project",
    "createdBy",
    "modded",
    "modManifest"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entrypoint",
        "templateVersion",
        "targetFamily"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^src/[A-Za-z0-9._/-]+$"
        },
        "templateVersion": {
          "type": "string"
        },
        "targetFamily": {
          "type": "string"
        }
      }
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "const": "2.0.0-beta.1"
        }
      }
    },
    "modded": {
      "const": true
    },
    "modManifest": {
      "const": "goode.mod.json"
    }
  }
}
